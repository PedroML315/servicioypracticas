<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Protección de descargas en uploads -->
        <rule name="Protect Uploads" stopProcessing="true">
          <match url="^uploads/(.*)$" ignoreCase="true" />
          <action type="Rewrite" url="controller/serve_pdf.php?file={R:1}" appendQueryString="true" />
        </rule>

        <!-- Manuales: solo se entregan con sesión y por perfil, desde controller/manuales.php -->
        <rule name="Protect Manuales" stopProcessing="true">
          <match url="^docs/manuales/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Regla general del sistema -->
        <rule name="Imported Rule 1">
          <match url="^([-a-zA-Z0-9/_&amp;=]+)$" ignoreCase="false" />
          <action type="Rewrite" url="index.php?pagina={R:1}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\unimontrer.edu.mx\tmp" />
  </system.web>
</configuration>